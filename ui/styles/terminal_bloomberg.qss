QWidget {
    background-color: #0a0e27;
    color: #e8e8e8;
    font-family: "Segoe UI";
    font-size: 9pt;
}
QMainWindow, QTabWidget, QTabWidget::pane { background: #0a0e27; border: 0; }
QMenuBar, QMenu { background: #0a0e27; color: #a0a0a0; border: 0; }
QMenu::item:selected { background: #1a1f3a; color: #ffd700; }
#marketSidebar { background: #141829; border-right: 1px solid #2a2e42; min-width: 180px; max-width: 180px; }
#sidebarBrand { color: #ffd700; font-family: "Consolas"; font-size: 12pt; font-weight: bold; letter-spacing: 2px; padding: 12px 8px; }
#sectionLabel, #tickerLabel { color: #606060; font-size: 8pt; font-weight: bold; letter-spacing: 1px; padding: 4px 8px; }
#navButton { min-height: 24px; text-align: left; border: 0; border-left: 3px solid transparent; padding: 4px 8px; color: #a0a0a0; background: transparent; }
#navButton:hover { background: #1a1f3a; color: #e8e8e8; }
#navButton:checked { background: #1a1f3a; border-left-color: #ffd700; color: #ffd700; font-weight: bold; }
#offlineLabel { color: #606060; font-family: "Consolas"; font-size: 8pt; padding: 8px; }
#globalTicker { min-height: 28px; max-height: 32px; background: #141829; border: 1px solid #2a2e42; }
#tickerBrand, #tickerClock { color: #ffd700; font-family: "Consolas"; font-size: 8pt; font-weight: bold; }
#tickerPositive, #tickerNegative { font-family: "Consolas"; font-size: 8pt; padding: 3px 6px; }
#tickerPositive, #metricPositive { color: #00d32f; }
#tickerNegative, #metricNegative { color: #ff3333; }
#pageTitle { color: #ffd700; font-size: 12pt; font-weight: bold; padding: 4px 0; }
#bloombergPanel, #denseCard, #phase4Panel, QGroupBox { background: #141829; border: 1px solid #2a2e42; border-radius: 0; padding: 4px; }
#panelHeading, #cardTitle { color: #ffd700; font-family: "Consolas"; font-size: 9pt; font-weight: bold; letter-spacing: 1px; }
#panelBody, #metricLabel { color: #a0a0a0; font-size: 8pt; }
#metricValue { color: #e8e8e8; font-family: "Consolas"; font-size: 9pt; }
#cardDivider { color: #2a2e42; background: #2a2e42; max-height: 1px; }
#compactButton, #accentButton { min-height: 22px; padding: 3px 8px; border: 1px solid #2a2e42; border-radius: 2px; background: #1a1f3a; color: #e8e8e8; font-size: 8pt; }
#compactButton:hover, #accentButton:hover { border-color: #ffd700; background: #1a1f3a; }
#accentButton { background: #ffd700; color: #0a0e27; font-weight: bold; }
#denseTable { background: #141829; alternate-background-color: #141829; border: 1px solid #2a2e42; gridline-color: #1a1f3a; }
#denseTable::item { padding: 2px 4px; color: #e8e8e8; font-family: "Consolas"; font-size: 8pt; }
#denseTable::item:hover { background: #1a1f3a; }
#denseTable::item:selected { background: #1a3a1a; color: #00d32f; }
QHeaderView::section { background: #0a0e27; color: #ffd700; padding: 2px 4px; border: 0; font-family: "Consolas"; font-size: 8pt; font-weight: bold; }
QTabBar::tab { min-width: 110px; min-height: 22px; padding: 2px 10px; color: #606060; background: #0a0e27; border: 0; }
QTabBar::tab:hover { color: #e8e8e8; background: #1a1f3a; }
QTabBar::tab:selected { color: #ffd700; border-bottom: 2px solid #ffd700; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { min-height: 22px; padding: 2px 6px; border: 1px solid #2a2e42; border-radius: 2px; background: #141829; color: #e8e8e8; font-family: "Consolas"; font-size: 8pt; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #ffd700; }
QStatusBar { min-height: 22px; background: #141829; border-top: 1px solid #2a2e42; color: #a0a0a0; font-family: "Consolas"; font-size: 8pt; }
QScrollBar:vertical { width: 8px; background: #0a0e27; }
QScrollBar::handle:vertical { background: #2a2e42; min-height: 20px; }
