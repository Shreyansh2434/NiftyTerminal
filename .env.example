APP_NAME=NIFTY Options Intelligence Terminal
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nifty_terminal
NSE_TIMEOUT_SECONDS=8
MARKET_CACHE_SECONDS=30
SCHEDULER_ENABLED=true
REFRESH_INTERVAL_SECONDS=60
VITE_API_BASE_URL=http://localhost:8000
# Phase 4 safety gates. Keep paper mode and the kill switch enabled for development.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
KILL_SWITCH_ACTIVE=true
MAX_ORDER_NOTIONAL=100000
MAX_PORTFOLIO_VAR=0.05
